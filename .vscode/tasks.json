{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install FA",
            "type": "shell",
            "command": "/data0/douzh/venv/bin/python",
            "args": [
                "setup.py",
                "install"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "Build Philox",
            "type": "shell",
            "command": "bisheng",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "-O0",
                "-g3",
                "-x",
                "asc",
                "philox.cpp",
                "-o",
                "build/philox",
                "--npu-arch=dav-2201"
            ],
            "group": {
                "kind": "build",
                // "isDefault": true
            },
        },
        {
            "label": "Kill lldb",
            "type": "shell",
            "command": "pkill -9 -u $(whoami) lldb || true",
            "presentation": {
                "echo": false,
                "reveal": "silent"
            },
        }
    ]
}